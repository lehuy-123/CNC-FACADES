# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG - CNC FACADES
# ==========================================

# 1. Database (PostgreSQL)
# Prisma ORM connection string
DATABASE_URL="postgresql://username:password@localhost:5432/cnc_booking_db?schema=public"

# 2. Quản trị viên (Admin Dashboard)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your-secure-admin-password"
SESSION_SECRET="your-random-32-character-session-secret"

# 3. Thông báo Email qua Gmail SMTP (Nodemailer)
ADMIN_NOTIFICATION_EMAIL="admin-email@example.com"
GMAIL_USER="your-gmail-account@gmail.com"
# Mật khẩu ứng dụng (App Password) 16 ký tự tạo trong Google Account Security
GMAIL_APP_PASSWORD="your-16-char-app-password"

# 4. AI Render ảnh phác thảo & CAD (Tùy chọn)
# Google Gemini Imagen 3 (Lấy API Key miễn phí tại https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="your-gemini-api-key"

# Hoặc Hugging Face Token (Nếu dùng model FLUX.1)
HF_TOKEN=""

# Hoặc OpenAI DALL-E 3 (nếu cấu hình thêm)
# OPENAI_API_KEY=""
